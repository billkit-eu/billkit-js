{
  "name": "@billkit-eu/js",
  "version": "0.1.0",
  "description": "Browser SDK for BillKit: the embedded checkout element (<CheckoutElement/>) served from js.billkit.eu. The Stripe-Elements-shaped payment UI for BillKit on Mollie.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "size": "npm run build && gzip -c dist/index.js | wc -c",
    "prepublishOnly": "npm run build && npm run test && npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "billkit",
    "checkout",
    "payment-element",
    "embedded",
    "mollie",
    "stripe",
    "browser"
  ],
  "author": "BillKit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billkit-eu/billkit-js.git"
  },
  "homepage": "https://github.com/billkit-eu/billkit-js#readme",
  "bugs": {
    "url": "https://github.com/billkit-eu/billkit-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^10.7.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "sideEffects": false
}
